{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"enabledManagers": [
		"github-actions",
		"nuget"
	],
	"packageRules": [
		{
			"groupName": "DotNet",
			"matchDatasources": [
				"nuget",
				"dotnet-version"
			]
		},
		{
			"groupName": "GitHub Actions",
			"matchManagers": [
				"github-actions"
			]
		}
	],
	"prConcurrentLimit": 10
}